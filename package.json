{
  "name": "@kavicki/swi-design-system",
  "version": "0.1.36",
  "description": "SWI Design System — universal React Native components for swi-admin and swi-app",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kavicki-com/swi-design-system.git"
  },
  "scripts": {
    "build": "tsup",
    "tokens:generate": "tsx scripts/generate-tokens.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:rn": "cd example-app && yarn start",
    "test": "vitest --passWithNoTests",
    "lint": "echo 'lint: noop (eslint v9 flat config not yet wired)' && exit 0",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=15",
    "react-native-web": ">=0.19",
    "styled-components": ">=6"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^9.0.0",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/react": "^9.0.0",
    "@storybook/react-vite": "^9.0.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "@types/styled-components": "^5.1.34",
    "@types/styled-components-react-native": "^5.2.5",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.1",
    "react-native": "^0.74.0",
    "react-native-svg": "^15.0.0",
    "react-native-web": "^0.19.0",
    "react-test-renderer": "^18.3.1",
    "storybook": "^9.0.0",
    "styled-components": "^6.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
